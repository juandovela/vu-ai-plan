{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "number",
      "const": 1
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "bad_request",
            "unauthorized",
            "forbidden",
            "payload_too_large",
            "unsupported_contract_version",
            "upstream_failed",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "error"
  ],
  "additionalProperties": false
}
