{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "number",
      "const": 1
    },
    "sheet": {
      "type": "object",
      "properties": {
        "planName": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "specs": {
          "default": {
            "sqft": null,
            "bedrooms": null,
            "baths": null
          },
          "type": "object",
          "properties": {
            "sqft": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "bedrooms": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "baths": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "sqft",
            "bedrooms",
            "baths"
          ],
          "additionalProperties": false
        },
        "elevations": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "marker": {
                "default": "",
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "page": {
                "default": null,
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "kind": {
                "default": "footnote",
                "type": "string",
                "enum": [
                  "footnote",
                  "drawing",
                  "general"
                ]
              },
              "appliesTo": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "effect": {
                "default": "info",
                "type": "string",
                "enum": [
                  "not-available",
                  "hide",
                  "excludes",
                  "depends-on",
                  "info"
                ]
              },
              "target": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "marker",
              "text",
              "page",
              "kind",
              "appliesTo",
              "effect",
              "target"
            ],
            "additionalProperties": false
          }
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "floorNumber": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "location": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "caption": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              },
              "insetKey": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              },
              "replaces": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "adds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "marker": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "floorNumber",
              "location",
              "name",
              "caption",
              "insetKey",
              "replaces",
              "adds",
              "marker"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "planName",
        "specs",
        "elevations",
        "notes",
        "options"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "sheet"
  ],
  "additionalProperties": false
}
